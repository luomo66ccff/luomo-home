NEXT_PUBLIC_SITE_NAME=Luomo Cloud
NEXT_PUBLIC_SITE_URL=https://luomo.moe

STATUS_FETCH_TIMEOUT_SECONDS=5
STATUS_CACHE_SECONDS=30

# Server-only probe origins. Public destination links live in lib/services.ts.
LUOMO_OPS_URL=https://ops.luomo.moe
LUOMO_FILE_URL=https://file.luomo.moe
LUOMO_API_URL=https://api.luomo.moe
LUOMO_TERMINAL_URL=https://terminal.luomo.moe
LUOMO_ATRI_API_URL=https://atri-api.luomo.moe

# Companion brain defaults to the local scripted provider.
# Configure the external provider only after its bridge token is stored securely.
ATRI_BRAIN_PROVIDER=scripted
ATRI_API_BASE_URL=
ATRI_API_BRAIN_PATH=/coze/atri/chat
ATRI_API_TOKEN=
ATRI_API_TIMEOUT_MS=8000
ATRI_ALLOW_SECRET_FORMS=false
ATRI_ALLOW_DEBUG_FORMS=false
ATRI_ALLOWED_ORIGINS=https://luomo.moe
ATRI_RATE_LIMIT_PER_MINUTE=20

LUOMO_HOME_HOST_PORT=7891
LUOMO_HOME_LIVE2D_PATH=./private-assets/live2d
